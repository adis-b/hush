        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus"
          }
        }
      }
    },
    "focus.hotkey" : {
      "comment" : "Keyboard shortcut hint shown next to the Focus label (Command-Option-H).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘H"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌥⌘H"
          }
        }
      }
    },
    "focus.duration.pomodoro" : {
      "comment" : "Short label on the 25-minute focus button. Refers to the Pomodoro technique.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomodoro"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomodoro"
          }
        }
      }
    },
    "focus.duration.deepwork" : {
      "comment" : "Short label on the 50-minute focus button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep Work"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep Work"
          }
        }
      }
    },
    "focus.duration.ultradian" : {
      "comment" : "Short label on the 90-minute focus button. Refers to ultradian rhythm / Kleitman cycle.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultradian"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultradian"
          }
        }
      }
    },
    "focus.help.pomodoro" : {
      "comment" : "Detailed help text for the 25-minute focus button. Contains a specific historical reference (Cirillo 1987) that should be translated appropriately in each language.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 min · one Pomodoro (Cirillo, 1987). After it ends, take a 5-min break."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 Min · ein Pomodoro (Cirillo, 1987). Danach 5 Min Pause."
          }
        }
      }
    },
    "focus.help.deepwork" : {
      "comment" : "Detailed help text for the 50-minute focus button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 min · two pomodoros, a Deep Work block."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 Min · zwei Pomodori, ein Deep-Work-Block."
          }
        }
      }
    },
    "focus.help.ultradian" : {
      "comment" : "Detailed help text for the 90-minute focus button. References Kleitman's ultradian rhythm research.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 min · one ultradian alertness cycle (Kleitman's basic rest-activity cycle)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 Min · ein ultradianer Wachsamkeitszyklus (Kleitmans grundlegender Ruhe-Aktivitäts-Zyklus)."
          }
        }
      }
    },
    "focus.help.generic" : {
