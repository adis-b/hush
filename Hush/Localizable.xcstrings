{
  "sourceLanguage" : "en",
  "strings" : {
    "content.select.all" : {
      "comment" : "Label for the master checkbox that selects/deselects all running apps in the popover list.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select All"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle auswählen"
          }
        }
      }
    },
    "content.menu.settings" : {
      "comment" : "Title of the button that opens the Settings window from the menu bar popover.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen"
          }
        }
      }
    },
    "content.menu.quit" : {
      "comment" : "Title of the button that quits the Hush app itself from the menu bar popover. Note: this is not the per-app quit button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quit Hush"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hush beenden"
          }
        }
      }
    },
    "approw.exempt.label" : {
      "comment" : "Short status badge shown next to an app that was launched *during* an active focus session and is therefore temporarily exempt from being quit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "exempt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ausgenommen"
          }
        }
      }
    },
    "approw.exempt.help" : {
      "comment" : "Tooltip / help text for the 'exempt' status badge.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opened during this focus session, Hush won't quit it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während dieser Fokus-Sitzung geöffnet, Hush wird es nicht beenden."
          }
        }
      }
    },
    "focus.label" : {
      "comment" : "Label for the focus section in the menu bar popover.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus"
