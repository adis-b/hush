    "settings.focus.fda.error" : {
      "comment" : "Error message when Full Disk Access is missing for Focus mirror.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hush can't read your Focus state. Grant Full Disk Access in System Settings, then re-toggle Hush in the FDA list after redeploying."
