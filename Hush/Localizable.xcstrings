    "focus.help.pomodoro" : {
      "comment" : "Detailed help text for the 25-minute focus button. Contains a specific historical reference (Cirillo 1987) that should be translated appropriately in each language.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 min · one Pomodoro (Cirillo, 1987). After it ends, take a 5-min break."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 Min · ein Pomodoro (Cirillo, 1987). Danach 5 Min Pause."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 min · un Pomodoro (Cirillo, 1987). À la fin, prenez une pause de 5 min."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 min · un Pomodoro (Cirillo, 1987). Al terminar, toma un descanso de 5 min."
          }
        }
      }
    },
    "focus.help.deepwork" : {
      "comment" : "Detailed help text for the 50-minute focus button.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 min · two pomodoros, a Deep Work block."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 Min · zwei Pomodori, ein Deep-Work-Block."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 min · deux pomodoros, un bloc Deep Work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 min · dos pomodoros, un bloque de Deep Work."
          }
        }
      }
    },
    "focus.help.ultradian" : {
      "comment" : "Detailed help text for the 90-minute focus button. References Kleitman's ultradian rhythm research.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 min · one ultradian alertness cycle (Kleitman's basic rest-activity cycle)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 Min · ein ultradianer Wachsamkeitszyklus (Kleitmans grundlegender Ruhe-Aktivitäts-Zyklus)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 min · un cycle ultradien de vigilance (cycle repos-activité de base de Kleitman)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "90 min · un ciclo de alerta ultradiano (ciclo básico de reposo-actividad de Kleitman)."
          }
        }
      }
    },
