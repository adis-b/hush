            "value" : "exempté"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "exento"
          }
        }
      }
    },
    "approw.exempt.help" : {
      "comment" : "Tooltip / help text for the 'exempt' status badge.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opened during this focus session, Hush won't quit it."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während dieser Fokus-Sitzung geöffnet, Hush wird es nicht beenden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvert pendant cette session Focus, Hush ne le fermera pas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abierto durante esta sesión Focus, Hush no lo cerrará."
          }
        }
      }
    },
