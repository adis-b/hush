    "privacy.focusstatus" : {
      "comment" : "Privacy description shown by macOS when requesting Focus status access (for mirroring).",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hush spiegelt deine aktiven macOS-Fokus-Modi, damit es automatisch eine Hush-Fokus-Sitzung starten kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hush mirrors your active macOS Focus modes so it can start a Hush focus session automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hush refleja tus modos Focus de macOS activos para poder iniciar automáticamente una sesión Focus de Hush."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hush reflète vos modes Focus macOS actifs pour pouvoir démarrer automatiquement une session Focus Hush."
          }
        }
      }
    },
